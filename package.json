{
  "name": "@incutonez/jefharkay",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "explode": "npm cache clean --force && npx rimraf package-lock.json **/node_modules --glob && npm i",
    "preview": "vite preview",
    "lint": "npx eslint --fix",
    "update:deps": "node ./updateDependencies.js",
    "update:versions": "node ./updateVersions.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@material-symbols/svg-400": "0.45.10",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@stylistic/stylelint-config": "5.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "eslint": "10.8.1",
    "eslint-plugin-antfu": "3.2.3",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "semantic-release": "25.0.9",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vite-svg-loader": "5.1.1",
    "vue-tsc": "3.3.9"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,vue}": [
      "npm run lint"
    ]
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  }
}
